<?xml version="1.0" encoding="UTF-8"?>
<!-- tgoct.suils.es: IIS/ARR proxy to OpenYuGi (NiceGUI) on 127.0.0.1:8205.
     NiceGUI sends every click over a socket.io WebSocket. With the IIS WebSocket module off,
     the handshake fails ("Incorrect Sec-WebSocket-Accept") and buttons such as "Crear cuenta"
     do nothing. The IIS module cannot relay compressed frames, so the rule replaces the
     permessage-deflate offer with an unknown token (same fix as mesa.nordicbyte.co.uk). -->
<configuration>
  <system.webServer>
    <webSocket enabled="true" pingInterval="00:00:30" />
    <!-- Scanned PDFs go up to 300 MB (MAX_PDF_BYTES); the IIS default is 30 MB. -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="314572800" />
      </requestFiltering>
    </security>
    <rewrite>
      <rules>
        <rule name="OpenYuGi" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_SEC_WEBSOCKET_EXTENSIONS" value="x-none" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:8205/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
  <system.web>
    <compilation tempDirectory="C:\Inetpub\vhosts\suils.es\tmp" />
  </system.web>
</configuration>
